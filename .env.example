# IDS live application settings
# Values are read from the process environment.
# Relative paths are resolved from the project root.

IDS_DB_FILE=ids_live.db
IDS_STATE_FILE=.runtime/ids_collector_state.json
IDS_SNORT_ALERT_FILE=/var/log/snort/alert_json.txt
IDS_SURICATA_EVE_FILE=/var/log/suricata/eve.json
IDS_INTERFACE=ens38

# The engines this machine runs: snort, suricata, or both. The collector
# reads only their logs, and the dashboard shows only them.
IDS_ENGINES=snort,suricata
# Each engine's rules (one file, or a folder of .rules files) and config
# file. Snort's registered rules are where the README unpacks them.
IDS_SNORT_RULES=/usr/local/etc/snort/registered/rules
IDS_SNORT_CONFIG=/usr/local/etc/snort/snort.lua
IDS_SURICATA_RULES=/var/lib/suricata/rules/suricata.rules
IDS_SURICATA_CONFIG=/etc/suricata/suricata.yaml
# How many rules each engine loaded; the rule update saves it.
IDS_RULE_COUNTS_FILE=.runtime/engine_rule_counts.json
# The basic rules both engines share, which setup.sh puts into the engines
# (with deploy/install-local-rules.sh) and the rule index adds to each
# engine's own. Empty: this machine's engines load no local rules.
IDS_LOCAL_RULES=deploy/rules/local.rules

# How many of the newest alerts the database keeps, about 2 KB each. At
# about 83,000 alerts a day, 600,000 keep a week (about 1.2 GB).
IDS_ALERT_RETENTION=200000
IDS_PACKET_RETENTION=5000

# The alerts past IDS_ALERT_RETENTION go to this folder instead of being
# deleted: a file a day, packed into a zip of IDS_ALERT_ARCHIVE_ZIP_DAYS days
# once those days have all left the database. The newest zips that cover
# IDS_ALERT_ARCHIVE_DAYS stay: 30 days in 10-day zips is 3 zips, about 100 MB
# each at 83,000 alerts a day. 0 days deletes the alerts instead.
IDS_ALERT_ARCHIVE_DIR=alert-archive
IDS_ALERT_ARCHIVE_DAYS=30
IDS_ALERT_ARCHIVE_ZIP_DAYS=10

# The statistics the engines write every minute, which the status panel
# reads for each engine's dropped packets over the last hour.
IDS_SNORT_PERF_FILE=/var/log/snort/perf_monitor_base.csv
IDS_SURICATA_STATS_FILE=/var/log/suricata/stats.log

# The most alerts one combined export holds. Building one takes about 8 KB
# of memory an alert: 150,000 take about 1.2 GB. Lower it on a smaller
# machine.
IDS_EXPORT_MAX_ALERTS=150000

# Every night (the ids-backup timer, 03:30, or at the next start when the
# machine was off) a gzipped copy of the database goes to this folder; the
# newest IDS_BACKUP_KEEP stay. 0 makes none.
IDS_BACKUP_DIR=backups
IDS_BACKUP_KEEP=3

IDS_BATCH_SIZE=100
IDS_BATCH_FLUSH_MS=250

IDS_RETENTION_INTERVAL_SECONDS=60

# NVD vulnerability enrichment
NVD_API_KEY=

# Dashboard API (src/dashboard_api.py): requests send
# "Authorization: Bearer <token>". Left empty, the API creates one in .env
# the first time it starts; `src/dashboard_api.py --new-token` replaces it.
IDS_API_TOKEN=
# false lets every request in without a token, for testing on a trusted
# network: anyone who can reach the API's port then sees the alerts.
IDS_API_REQUIRE_TOKEN=true

# The LLM PC: the Alert Explorer's Send button POSTs the combined JSON of
# the alerts its filters choose to this address (http:// or https://), with
# "Authorization: Bearer <IDS_LLM_TOKEN>" when a token is set. Left empty,
# Send is off. Restart the dashboard after changing them.
IDS_LLM_URL=
IDS_LLM_TOKEN=

# Live alert intelligence
IDS_INTELLIGENCE_CACHE_DIR=data/lab/intelligence/live_alerts
IDS_INTELLIGENCE_POLL_SECONDS=5
IDS_INTELLIGENCE_BATCH_SIZE=25
