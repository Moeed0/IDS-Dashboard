# Basic local rules for both engines. The same text works in Snort 3 and
# Suricata 8: deploy/install-local-rules.sh installs this file as
# /usr/local/etc/snort/local.rules (included by Snort's config) and as
# /etc/suricata/rules/local.rules (in Suricata's rule-files), so a packet
# that matches raises an alert from both engines.
#
# SIDs from 1000001 are kept for local rules by both engines' rule sets, and
# every message starts with "LOCAL", so these alerts are easy to find. They
# use no content modifiers (nocase, distance): Snort 3 writes those inside
# the content option and Suricata as keywords after it, so one text could
# not suit both. Each string is matched with the case the tools send.

# Ping: an echo request and its reply.
alert icmp any any -> any any (msg:"LOCAL ICMP echo request (ping)"; itype:8; classtype:misc-activity; sid:1000001; rev:1;)
alert icmp any any -> any any (msg:"LOCAL ICMP echo reply"; itype:0; classtype:misc-activity; sid:1000002; rev:1;)

# The first packet (SYN) of a connection to a remote-login or file-sharing
# service.
alert tcp any any -> any 21 (msg:"LOCAL FTP connection attempt"; flags:S; classtype:attempted-recon; sid:1000003; rev:1;)
alert tcp any any -> any 22 (msg:"LOCAL SSH connection attempt"; flags:S; classtype:attempted-recon; sid:1000004; rev:1;)
alert tcp any any -> any 23 (msg:"LOCAL Telnet connection attempt"; flags:S; classtype:attempted-recon; sid:1000005; rev:1;)
alert tcp any any -> any 445 (msg:"LOCAL SMB connection attempt"; flags:S; classtype:attempted-recon; sid:1000006; rev:1;)
alert tcp any any -> any 3389 (msg:"LOCAL RDP connection attempt"; flags:S; classtype:attempted-recon; sid:1000007; rev:1;)

# Scanners and attacks in what a client sends, matched in the packet's own
# bytes, which both engines read the same way: the user agents Nmap's
# scripts, sqlmap and Nikto send.
alert tcp any any -> any any (msg:"LOCAL Nmap Scripting Engine in a request"; flow:to_server,established; content:"Nmap Scripting Engine"; classtype:attempted-recon; sid:1000008; rev:1;)
alert tcp any any -> any any (msg:"LOCAL sqlmap in a request"; flow:to_server,established; content:"sqlmap/"; classtype:web-application-attack; sid:1000009; rev:1;)
alert tcp any any -> any any (msg:"LOCAL Nikto in a request"; flow:to_server,established; content:"Nikto/"; classtype:attempted-recon; sid:1000010; rev:1;)
# "../" alone turns up in encrypted bytes now and then: only with an HTTP
# version in the same packet.
alert tcp any any -> any any (msg:"LOCAL Directory traversal in an HTTP request"; flow:to_server,established; content:"../"; content:"HTTP/1."; classtype:web-application-attack; sid:1000011; rev:1;)
alert tcp any any -> any any (msg:"LOCAL /etc/passwd in a request"; flow:to_server,established; content:"/etc/passwd"; classtype:attempted-user; sid:1000012; rev:1;)
